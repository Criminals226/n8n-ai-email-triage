      ],
      "id": "b44afad2-079c-4f4e-afbd-63f210c8ccac",
      "name": "AI Email Classifier"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const output = $json.text || $json.output || '';\n\nconst category = output.match(/Category:\\s*(.+)/i)?.[1]?.trim() || 'GENERAL';\nconst priority = output.match(/Priority:\\s*(.+)/i)?.[1]?.trim() || 'MEDIUM';\nconst reason = output.match(/Reason:\\s*(.+)/i)?.[1]?.trim() || '';\n\nreturn {\n  json: {\n    ...$json,\n    category: category.toUpperCase(),\n    priority: priority.toUpperCase(),\n    reason\n  }\n};"
      },
